
# APP
RAG_APP_NAME=Clause
RAG_DATA_PATH=data/shop_handbook.pdf

# CHAT
RAG_CHAT_PROVIDER = ollama
RAG_CHAT_MODEL=llama3.2:3b
RAG_CHAT_TEMPERATURE=0.1


# EMBEDDINGS
RAG_EMBED_PROVIDER=ollama
RAG_EMBED_MODEL=nomic-embed-text:latest
RAG_EMBED_DIM=768

# INDEXING
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

#RETRIEVAL
TOP_K = 3
SCORE_THRESHOLD=0.5

# QDRANT
RAG_COLLECTION=shop_handbook
RAG_QDRANT_DATA=./vectors_store
RAG_QDRANT_URL=

# PROMPTS
RAG_SYSTEM="
        You are a helpful AI Assistant.
        Answer the user's question using ONLY the provided context.
        Answer all parts clearly and directly.
        Do not repeat information. "
        If the context does not contain the answer,
        say that you don't know.

"

# Optional: Use only if connecting to remote Qdrant
# RAG_QDRANT_URL = http:/localhost:6333
