# Copy to .env. Every setting needs the RAG_ prefix (see app/core/config.py).

# ---------- App ----------
RAG_APP_NAME=Clause
RAG_DATA_PATH=data/shop_handbook.pdf

# ---------- Chat model (LangChain init_chat_model) ----------
# Local and free with Ollama:  ollama pull qwen3.5:4b
RAG_CHAT_PROVIDER=google_genai
RAG_CHAT_MODEL=gemini-3.1-flash-lite
RAG_CHAT_TEMPERATURE=0.0
RAG_CHAT_API_KEY=

# RAG_CHAT_PROVIDER=google_genai
# RAG_CHAT_MODEL=gemini-3.5-flash-lite

# ---------- Embeddings ----------
# Local with Ollama:  ollama pull nomic-embed-text
RAG_EMBED_PROVIDER=ollama
RAG_EMBED_MODEL=nomic-embed-text:latest
RAG_EMBED_DIM=768

# ---------- Indexing ----------
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# ---------- Retrieval ----------
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.0

# ---------- Qdrant ----------
RAG_COLLECTION_NAME=shop_handbook
RAG_QDRANT_PATH=./vector_stores
# RAG_QDRANT_URL=http://localhost:6333

# ---------- Prompts ----------
RAG_SYSTEM_PROMPT_VERSION=v3
